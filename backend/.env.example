# SQLite by default; docker-compose.yml overrides this to Postgres.
DATABASE_URL=sqlite:///backend/database/sports_strategy.db

# Celery broker/result backend and the metrics cache.
REDIS_URL=redis://127.0.0.1:6379/0

# Root for the five trained checkpoints. Defaults to <repo>/models; each
# model's path under it comes from configs/models.yaml, never from an env var.
# Verify a deploy with: python -m scripts.print_model_env --check
SSC_MODEL_ROOT=

# Dataset root for the training/QA scripts. Defaults per-OS from configs/datasets.yaml.
SSC_DATASET_ROOT=

# Run the field and goalpost models every Nth frame. The ball is never strided.
FIELD_DETECT_STRIDE=25
GOALPOST_DETECT_STRIDE=25

# Per-match manual calibration JSON. A file here overrides auto-calibration.
CALIBRATION_DIR=calibrations

# Persist a raw Frame/PlayerDetection/BallDetection row every Nth frame.
FRAME_PERSIST_STRIDE=5

# Run pose estimation every Nth frame per player.
POSE_SAMPLE_STRIDE=10

# Origins the backend's CORS policy allows.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Security -------------------------------------------------------------
# Shared-secret API key. Unset = auth disabled (local dev). When set, every
# request except GET /health must send it as the X-API-Key header. The
# dashboard reads the same value from VITE_SSC_API_KEY at build time.
SSC_API_KEY=

# Maximum upload size in bytes. Default 2147483648 (2 GiB).
MAX_UPLOAD_BYTES=
