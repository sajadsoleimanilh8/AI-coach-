# Copy to .env.local. All VITE_* values are compiled into the public bundle:
# anyone who can load the dashboard can read them.
VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_NEXUS_BASE_URL=http://127.0.0.1:8100

# Only when the services run with SSC_API_KEY / NEXUS_API_KEY set.
VITE_SSC_API_KEY=
VITE_NEXUS_API_KEY=
