# Shared-secret API key for the NEXUS service. Unset = auth disabled (local
# dev). When set, every request except GET /api/health must send it as the
# X-API-Key header. The dashboard reads it from VITE_NEXUS_API_KEY.
NEXUS_API_KEY=

# The python tool runs model-written code with NO sandbox. It is off by
# default. Set to 1 only inside a disposable container.
NEXUS_ENABLE_PYTHON_TOOL=

# Origins the NEXUS CORS policy allows.
NEXUS_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Cloud providers (all optional; Ollama works without any of these).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GITHUB_TOKEN=
