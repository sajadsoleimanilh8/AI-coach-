{"id": "forecast_001", "suite": "forecast", "input": {"dimension": "physical.energy", "values": [0.5, 0.52, 0.54, 0.56], "day_spacing": 1.0, "horizon_days": 7}, "expected": {"method": "trend_extrapolation", "projected_value": 0.672, "tolerance": 0.05}, "metadata": {"why": "clean +0.02/day slope over 4 points projects forward by 0.14 in 7 days"}}
{"id": "forecast_002", "suite": "forecast", "input": {"dimension": "physical.energy", "values": [0.8, 0.78, 0.76, 0.74], "day_spacing": 1.0, "horizon_days": 7}, "expected": {"method": "trend_extrapolation", "projected_value": 0.628, "tolerance": 0.05}, "metadata": {"why": "the same magnitude of slope in the negative direction"}}
{"id": "forecast_003", "suite": "forecast", "input": {"dimension": "physical.energy", "values": [0.6, 0.6, 0.6, 0.6], "day_spacing": 1.0, "horizon_days": 10}, "expected": {"method": "trend_extrapolation", "projected_value": 0.6, "tolerance": 0.01}, "metadata": {"why": "a perfectly flat series is a perfectly certain 'stable' — projection equals current"}}
{"id": "forecast_004", "suite": "forecast", "input": {"dimension": "physical.energy", "values": [0.5, 0.55, 0.6], "day_spacing": 1.0, "horizon_days": 7}, "expected": {"method": "insufficient_data"}, "metadata": {"why": "3 points is under trend_min_samples=4 — no number, however clean the line looks"}}
{"id": "forecast_005", "suite": "forecast", "input": {"dimension": "physical.energy", "values": [0.5, 0.7], "day_spacing": 1.0, "horizon_days": 7}, "expected": {"method": "insufficient_data"}, "metadata": {"why": "two points always fit a line perfectly; sample count is what stops this, not fit quality"}}
{"id": "forecast_006", "suite": "forecast", "input": {"dimension": "physical.energy", "values": [0.2, 0.9, 0.25, 0.85], "day_spacing": 1.0, "horizon_days": 7}, "expected": {"method": "insufficient_data"}, "metadata": {"why": "enough samples but the fit explains almost none of the scatter — R^2 below min_trend_confidence"}}
{"id": "forecast_007", "suite": "forecast", "input": {"dimension": "physical.energy", "values": [0.5, 0.51, 0.52, 0.53], "day_spacing": 1.0, "horizon_days": 90, "max_horizon_days": 30}, "expected": {"method": "trend_extrapolation", "max_horizon_days": 30, "projected_value": 0.815, "tolerance": 0.06}, "metadata": {"why": "a 90-day request is capped to 30 days rather than refused"}}
{"id": "forecast_008", "suite": "forecast", "input": {"dimension": "mental.stress", "values": [0.3, 0.32, 0.34, 0.36], "day_spacing": 1.0, "horizon_days": 7}, "expected": {"method": "trend_extrapolation", "projected_value": 0.472, "tolerance": 0.05}, "metadata": {"why": "an inverted dimension projects on its raw value; the sign flip belongs to trend direction, not the projection"}}
{"id": "forecast_009", "suite": "forecast", "input": {"dimension": "physical.energy", "values": [0.7, 0.8, 0.9, 1.0], "day_spacing": 1.0, "horizon_days": 30}, "expected": {"method": "trend_extrapolation", "projected_value": 1.0, "tolerance": 0.001}, "metadata": {"why": "a steep slope over a long horizon clamps to the top of the [0,1] scale rather than reporting 3.8"}}
